{
  "boot-source": {
    "kernel_image_path": "/home/ubuntu/microvm-lab/guest-kernel",
    "boot_args": "keep_bootcon console=ttyS0 reboot=k panic=1"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/home/ubuntu/microvm-lab/guest-vm2.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 768,
    "smt": false
  },
  "pmem": [
    {
      "id": "pmem0",
      "path_on_host": "/home/ubuntu/microvm-lab/model-pmem.ext4",
      "root_device": false,
      "read_only": true
    }
  ]
}